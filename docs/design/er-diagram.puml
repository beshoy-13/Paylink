@startuml PayLink Entity Relationship Diagram
hide circle
skinparam linetype ortho
skinparam shadowing false
skinparam packageStyle rectangle

package "Accounts & Wallet" {
    entity Account {
        * Id : UUID <<PK>>
        --
        FullName : VARCHAR(200)
        Email : VARCHAR(320) <<UK>>
        PhoneNumber : VARCHAR(32) <<UK>>
        PasswordHash : TEXT
        Role : VARCHAR(32)
        VerificationLevel : VARCHAR(32)
        Status : VARCHAR(32)
        CreatedAt : TIMESTAMPTZ
    }

    entity Wallet {
        * Id : UUID <<PK>>
        --
        * AccountId : UUID <<FK, UK>>
    }

    entity LedgerEntry {
        * Id : UUID <<PK>>
        --
        * WalletId : UUID <<FK>>
        TopUpId : UUID <<FK, nullable>>
        PaymentId : UUID <<FK, nullable>>
        RefundRequestId : UUID <<FK, nullable>>
        Amount : NUMERIC(18,2)
        EntryType : VARCHAR(32)
        Description : TEXT
        CreatedAt : TIMESTAMPTZ
    }

    entity Hold {
        * Id : UUID <<PK>>
        --
        * WalletId : UUID <<FK>>
        * PaymentId : UUID <<FK, UK>>
        Amount : NUMERIC(18,2)
        Status : VARCHAR(32)
        CreatedAt : TIMESTAMPTZ
        ReleasedAt : TIMESTAMPTZ <<nullable>>
    }

    entity TopUp {
        * Id : UUID <<PK>>
        --
        * WalletId : UUID <<FK>>
        * InitiatedByAccountId : UUID <<FK>>
        Amount : NUMERIC(18,2)
        Method : VARCHAR(32)
        Status : VARCHAR(32)
        ExternalReference : VARCHAR(255) <<nullable>>
        CreatedAt : TIMESTAMPTZ
        CompletedAt : TIMESTAMPTZ <<nullable>>
    }
}

package "Biller Catalog" {
    entity Biller {
        * Id : UUID <<PK>>
        --
        Name : VARCHAR(200)
        Code : VARCHAR(64) <<UK>>
        Status : VARCHAR(32)
    }

    entity BillerService {
        * Id : UUID <<PK>>
        --
        * BillerId : UUID <<FK>>
        Name : VARCHAR(200)
        Code : VARCHAR(64)
        MinimumAmount : NUMERIC(18,2)
        MaximumAmount : NUMERIC(18,2)
        Status : VARCHAR(32)
    }

    entity RequiredField {
        * Id : UUID <<PK>>
        --
        * BillerServiceId : UUID <<FK>>
        Name : VARCHAR(128)
        DataType : VARCHAR(32)
        IsRequired : BOOLEAN
        ValidationRules : JSONB
    }
}

package "Payment Processing" {
    entity Payment {
        * Id : UUID <<PK>>
        --
        * AccountId : UUID <<FK>>
        AgentAccountId : UUID <<FK, nullable>>
        * BillerServiceId : UUID <<FK>>
        Amount : NUMERIC(18,2)
        FeeAmount : NUMERIC(18,2)
        TotalAmount : NUMERIC(18,2)
        Status : VARCHAR(32)
        BillerReference : VARCHAR(255) <<nullable>>
        CreatedAt : TIMESTAMPTZ
        CompletedAt : TIMESTAMPTZ <<nullable>>
    }

    entity IdempotencyKey {
        * Id : UUID <<PK>>
        --
        * AccountId : UUID <<FK>>
        * PaymentId : UUID <<FK, UK>>
        Key : VARCHAR(255) <<UK (AccountId, Key)>>
        CreatedAt : TIMESTAMPTZ
    }

    entity PaymentStatusHistory {
        * Id : UUID <<PK>>
        --
        * PaymentId : UUID <<FK>>
        PreviousStatus : VARCHAR(32) <<nullable>>
        NewStatus : VARCHAR(32)
        ChangedAt : TIMESTAMPTZ
        Reason : TEXT <<nullable>>
    }

    entity RefundRequest {
        * Id : UUID <<PK>>
        --
        * PaymentId : UUID <<FK>>
        * RequestedBy : UUID <<FK>>
        Reason : TEXT
        Status : VARCHAR(32)
        ApprovedBy : UUID <<FK, nullable>>
        CreatedAt : TIMESTAMPTZ
        ApprovedAt : TIMESTAMPTZ <<nullable>>
    }

    entity AuditEvent {
        * Id : UUID <<PK>>
        --
        ActorAccountId : UUID <<FK, nullable>>
        EventType : VARCHAR(64)
        EntityType : VARCHAR(128)
        EntityId : UUID
        Details : JSONB
        CreatedAt : TIMESTAMPTZ
    }
}

package "Biller Integration" {
    entity BillerIntegration {
        * Id : UUID <<PK>>
        --
        * BillerId : UUID <<FK, UK>>
        Protocol : VARCHAR(32)
        Endpoint : TEXT
        Configuration : JSONB
        TimeoutSeconds : INTEGER
        RetryPolicy : JSONB
        Status : VARCHAR(32)
    }

    entity BillerCallback {
        * Id : UUID <<PK>>
        --
        * BillerIntegrationId : UUID <<FK>>
        * PaymentId : UUID <<FK>>
        ExternalEventId : VARCHAR(255)
        ReceivedAt : TIMESTAMPTZ
        ProcessingStatus : VARCHAR(32)
        ProcessedAt : TIMESTAMPTZ <<nullable>>
    }
}

package "Fees & Commissions" {
    entity FeeRule {
        * Id : UUID <<PK>>
        --
        * BillerServiceId : UUID <<FK>>
        FeeType : VARCHAR(32)
        FeeValue : NUMERIC(18,2)
        MinimumFee : NUMERIC(18,2) <<nullable>>
        MaximumFee : NUMERIC(18,2) <<nullable>>
        IsActive : BOOLEAN
    }

    entity Promotion {
        * Id : UUID <<PK>>
        --
        * BillerServiceId : UUID <<FK>>
        Name : VARCHAR(200)
        DiscountType : VARCHAR(32)
        DiscountValue : NUMERIC(18,2)
        StartDate : TIMESTAMPTZ
        EndDate : TIMESTAMPTZ
        IsActive : BOOLEAN
    }

    entity Commission {
        * Id : UUID <<PK>>
        --
        * PaymentId : UUID <<FK, UK>>
        * AgentAccountId : UUID <<FK>>
        Amount : NUMERIC(18,2)
        Status : VARCHAR(32)
        CreatedAt : TIMESTAMPTZ
    }
}

package "Fraud Checks" {
    entity FraudRule {
        * Id : UUID <<PK>>
        --
        Name : VARCHAR(200)
        RuleType : VARCHAR(32)
        Configuration : JSONB
        IsActive : BOOLEAN
    }

    entity FraudAssessment {
        * Id : UUID <<PK>>
        --
        * AccountId : UUID <<FK>>
        * FraudRuleId : UUID <<FK>>
        PaymentId : UUID <<FK, nullable>>
        Result : VARCHAR(32)
        Reason : TEXT
        AssessedAt : TIMESTAMPTZ
    }

    entity ConfigSetting {
        * Id : UUID <<PK>>
        --
        Key : VARCHAR(128) <<UK>>
        Value : JSONB
        UpdatedByAccountId : UUID <<FK, nullable>>
        UpdatedAt : TIMESTAMPTZ
    }
}

package "Notifications" {
    entity Notification {
        * Id : UUID <<PK>>
        --
        * AccountId : UUID <<FK>>
        PaymentId : UUID <<FK, nullable>>
        Channel : VARCHAR(32)
        Recipient : VARCHAR(320)
        Template : VARCHAR(128)
        Status : VARCHAR(32)
        RetryCount : INTEGER
        CreatedAt : TIMESTAMPTZ
        SentAt : TIMESTAMPTZ <<nullable>>
    }
}

package "Reconciliation" {
    entity SettlementFile {
        * Id : UUID <<PK>>
        --
        * BillerId : UUID <<FK>>
        FileName : VARCHAR(255)
        FileHash : VARCHAR(128) <<UK>>
        StorageReference : TEXT
        Status : VARCHAR(32)
        ReceivedAt : TIMESTAMPTZ
        ProcessedAt : TIMESTAMPTZ <<nullable>>
    }

    entity ReconciliationRun {
        * Id : UUID <<PK>>
        --
        * BillerId : UUID <<FK>>
        SettlementFileId : UUID <<FK, nullable>>
        StartedAt : TIMESTAMPTZ
        CompletedAt : TIMESTAMPTZ <<nullable>>
        Status : VARCHAR(32)
        ReportReference : VARCHAR(255) <<nullable>>
    }

    entity ReconciliationItem {
        * Id : UUID <<PK>>
        --
        * ReconciliationRunId : UUID <<FK>>
        PaymentId : UUID <<FK, nullable>>
        ExternalReference : VARCHAR(255)
        InternalAmount : NUMERIC(18,2) <<nullable>>
        ExternalAmount : NUMERIC(18,2)
        MatchStatus : VARCHAR(32)
        Difference : NUMERIC(18,2)
    }
}

Account ||--|| Wallet : owns
Wallet ||--o{ LedgerEntry : contains
Wallet ||--o{ Hold : maintains
Wallet ||--o{ TopUp : receives
Account ||--o{ TopUp : initiates

TopUp ||--o{ LedgerEntry : generates
Payment ||--o{ LedgerEntry : generates
RefundRequest ||--o{ LedgerEntry : generates

Payment ||--o| Hold : reserves
Payment ||--|| IdempotencyKey : deduplicated by
Account ||--o{ IdempotencyKey : scopes
Account ||--o{ Payment : makes
Account |o--o{ Payment : agent account
BillerService ||--o{ Payment : targeted by
Payment ||--o{ PaymentStatusHistory : records
Payment ||--o{ RefundRequest : may have
Account ||--o{ RefundRequest : requests
Account |o--o{ RefundRequest : approves

Biller ||--o{ BillerService : offers
BillerService ||--o{ RequiredField : defines
Biller ||--|| BillerIntegration : configures
BillerIntegration ||--o{ BillerCallback : receives
Payment ||--o{ BillerCallback : receives

BillerService ||--o{ FeeRule : has
BillerService ||--o{ Promotion : offers
Payment ||--o| Commission : generates
Account ||--o{ Commission : earns

FraudRule ||--o{ FraudAssessment : evaluates
Account ||--o{ FraudAssessment : assessed account
Payment |o--o{ FraudAssessment : assessed payment
Account |o--o{ ConfigSetting : updates

Account ||--o{ Notification : receives
Payment |o--o{ Notification : triggers

Biller ||--o{ ReconciliationRun : has
Biller ||--o{ SettlementFile : provides
SettlementFile ||--o| ReconciliationRun : imported as
ReconciliationRun ||--o{ ReconciliationItem : contains
Payment |o--o{ ReconciliationItem : compared

Account |o--o{ AuditEvent : optional actor

note right of LedgerEntry
  LedgerEntry.Amount is signed:
  positive = credit; negative = debit.
  Exactly one of TopUpId, PaymentId, or
  RefundRequestId is populated.
  A source operation may create multiple entries.
  EntryType distinguishes holds, hold releases,
  charges, fee income, commissions, top-ups,
  and refunds. Hold entries change HeldBalance;
  they do not post a wallet debit.
end note

note right of Wallet
  AccountId is UNIQUE, enforcing one wallet
  per account.
  Computed wallet balances (not stored attributes):
  PostedBalance sums posted entries. Hold
  entries are negative and releases positive;
  HeldBalance is -SUM(hold/release Amount), and
  AvailableBalance = PostedBalance - HeldBalance.
  Requests to set balances directly are rejected.
end note

note right of Hold
  PaymentId is UNIQUE: each payment has
  zero or one hold.
  Amount reserves Payment.TotalAmount,
  including fees. Hold and release movements
  are represented by LedgerEntry rows.
end note

note right of TopUp
  Failed or pending top-ups may have no
  LedgerEntry. Successful card top-ups create
  one entry; agent cash top-ups create two
  entries for the source and destination wallets.
end note

note right of Payment
  Amount = bill amount.
  TotalAmount = Amount + FeeAmount.
  The wallet debit is TotalAmount.
  Payment ledger entries include the hold,
  final charge, fee income, and applicable
  agent commission; a hold release has its
  own entry. IdempotencyKey is a separate
  record, unique by (AccountId, Key).
  Unknown payments retain their holds
  until the outcome is resolved.
end note

note right of IdempotencyKey
  UNIQUE (AccountId, Key) prevents duplicate
  requests within an account. PaymentId is
  UNIQUE so a payment has one idempotency key.
end note

note right of BillerService
  UNIQUE (BillerId, Code).
  CHECK (MinimumAmount >= 0).
  CHECK (MaximumAmount >= MinimumAmount).
end note

note right of BillerCallback
  UNIQUE (BillerIntegrationId, ExternalEventId)
  prevents duplicate callback processing.
end note

note right of Commission
  PaymentId is UNIQUE, so a payment
  generates zero or one commission.
  Commissions apply only to agent-assisted
  payments and amounts are non-negative.
end note

note right of Notification
  RetryCount is between 0 and 3.
  After three failed retries, Status is
  Undelivered.
end note

note right of ReconciliationItem
  MatchStatus distinguishes Matched,
  Discrepancy, and Unmatched records.
  PaymentId is nullable so unmatched external
  settlement rows can be stored.
end note

note right of SettlementFile
  FileHash prevents importing the same
  settlement file more than once.
end note

note "Database integrity rules:\n- Monetary values use NUMERIC(18,2), never floating point.\n- Monetary amounts, fees, commissions, and retry counts have non-negative/range checks.\n- Status, role, type, and verification values use constrained domain values.\n- Financial record and ledger updates are atomic.\n- A refund is eligible only for a completed payment and creates a positive ledger entry.\n- Admin-editable limits are stored as ConfigSetting values; fees and promotions use FeeRule and Promotion." as IntegrityRules

@enduml
